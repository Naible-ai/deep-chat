# ==============================================
# SECURITY SETTINGS
# ==============================================

# Allowed origins for CORS (comma-separated)
# Example: http://localhost:3000,https://yourdomain.com
# Use * for development only (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000

# Node environment
NODE_ENV=development

# Server port
PORT=8080